      }
    },
    "Reset all progress?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser toute la progression ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamten Fortschritt zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer todo el progreso?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه پیشرفت بازنشانی شود؟"
          }
        }
      }
    },
    "Stars and best scores for every level will be deleted. This cannot be undone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étoiles et les meilleurs scores de tous les niveaux seront supprimés. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterne und Bestwerte aller Level werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán las estrellas y las mejores puntuaciones de todos los niveles. No se puede deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ستاره‌ها و بهترین امتیازهای همه مراحل حذف می‌شوند. این کار قابل بازگشت نیست."
          }
        }
      }
    },
    "Level %lld": {
      "localizations": {
