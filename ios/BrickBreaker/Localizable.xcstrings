          "stringUnit": {
            "state": "translated",
            "value": "هنوز مرحله‌ای تمام نشده"
          }
        }
      }
    },
    "Finish a level and it shows up here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez un niveau pour le voir ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaffe ein Level, dann erscheint es hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un nivel y aparecerá aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک مرحله را تمام کنید تا اینجا نمایش داده شود."
          }
        }
      }
    },
    "Done": {
      "localizations": {
