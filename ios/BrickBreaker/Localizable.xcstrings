    "Level %lld, %lld of 3 stars, best score %lld": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau %1$lld, %2$lld étoiles sur 3, meilleur score %3$lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Level %1$lld, %2$lld von 3 Sternen, Bestwert %3$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel %1$lld, %2$lld de 3 estrellas, mejor puntuación %3$lld"
